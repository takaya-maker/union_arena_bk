@echo off
echo.
echo ????????????????????????????????????????????????????????????????
echo ?                                                              ?
echo ?        ? Union Arena GUI Test Environment Setup            ?
echo ?                                                              ?
echo ????????????????????????????????????????????????????????????????
echo.

echo ? Installing dependencies...
call npm install

if %errorlevel% neq 0 (
    echo ? npm install failed
    pause
    exit /b 1
)

echo.
echo ? Installing Playwright browsers...
call npx playwright install

if %errorlevel% neq 0 (
    echo ? Playwright browser installation failed
    pause
    exit /b 1
)

echo.
echo ? Creating directories...
if not exist "screenshots" mkdir screenshots
if not exist "reports" mkdir reports

echo.
echo ? Setup completed successfully!
echo.
echo ? To run tests:
echo    npm test          - Interactive test runner
echo    npm run test:gui  - Full comprehensive test
echo    npm run test:battlefield - BattleField UI tests
echo    npm run test:combat - Combat system tests
echo.
echo ??  Make sure Union Arena app is running on http://localhost:3000
echo.
pause